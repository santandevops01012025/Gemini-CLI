# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files
!override.tf
!override.tf.json
!*_override.tf
!*_override.tf.json

# Include plugin cache directory
!.terraform/plugin-cache

# Exclude .terraformrc and terraform.rc
.terraformrc
terraform.rc

# Exclude variables files
# *.tfvars
# *.tfvars.json

# Exclude sensitive files
.env

# Terraform State Files
.tfstate
.tfstate.backup
